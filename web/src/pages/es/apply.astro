---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'Encuentra Tarjetas de Crédito para ITIN';
const description =
  'Explora nuestras guías independientes para encontrar emisores de tarjetas que aceptan un ITIN en lugar del Seguro Social.';
---
<BaseLayout title={title} description={description} path="/es/apply" noindex={true}>
  <section class="section">
    <div class="container narrow" style="text-align:center;padding:48px 0">
      <h1>Encuentra tarjetas de crédito para ITIN</h1>
      <p class="lede" style="margin:0 auto 24px;max-width:36em">
        Explora nuestras guías para encontrar emisores de tarjetas que aceptan
        un ITIN en lugar del Seguro Social, tarjetas con garantía, sin garantía
        y de negocio.
      </p>
      <a class="btn btn-primary btn-lg" href="/es/itin-credit-cards-guide">Ver guías de tarjetas con ITIN</a>
      <p style="margin-top:20px"><a href="/es/articles">Ver todas las guías &rarr;</a></p>
    </div>
  </section>
</BaseLayout>
