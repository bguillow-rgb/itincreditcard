---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Find ITIN Credit Card Options';
const description =
  'Browse our independent guides to find credit card issuers that accept an ITIN. Secured, unsecured, and business cards covered.';
---
<BaseLayout title={title} description={description} path="/apply" noindex={true}>
  <section class="section">
    <div class="container narrow" style="text-align:center;padding:48px 0">
      <h1>Find ITIN Credit Card Options</h1>
      <p class="lede" style="margin:0 auto 24px;max-width:36em">
        Browse our guides to find credit card issuers that accept an ITIN in place
        of an SSN, covering secured cards, unsecured cards, and business cards.
      </p>
      <a class="btn btn-primary btn-lg" href="/itin-credit-cards-guide">Browse ITIN Credit Card Guides</a>
      <p style="margin-top:20px"><a href="/articles">See all guides &rarr;</a></p>
    </div>
  </section>
</BaseLayout>
